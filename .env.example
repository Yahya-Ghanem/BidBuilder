# Copy to .env and fill in. .env is gitignored.

# Postgres (the compose db service reads these)
POSTGRES_DB=bidbuilder
POSTGRES_USER=bidbuilder
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key for the API — must be >= 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-signing-key-at-least-32-bytes

# ── Production only (docker-compose.prod.yml) ───────────────────────────────────
# Public hostname + URL the site is served from (single origin behind Caddy/TLS).
PUBLIC_DOMAIN=bid.example.com
PUBLIC_URL=https://bid.example.com
# Contact email for Let's Encrypt certificate notices.
ACME_EMAIL=ops@example.com
# First-run admin seed. In Production no admin is created unless this is set.
# Leave blank to create the initial admin out-of-band instead.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com

# ── Backup / PITR cadence (19.4) ────────────────────────────────────────────────
# Logical pg_dump cadence + retention (the daily nightly).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Physical base-backup cadence (anchors PITR replay). Weekly by default.
BASEBACKUP_INTERVAL_SECONDS=604800
# WAL retention. Must be ≥ BASEBACKUP_INTERVAL_SECONDS / 86400, ideally double,
# so we never prune WAL that would orphan a base backup we still want to use.
WAL_RETENTION_DAYS=21
