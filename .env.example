# Copy to .env and fill in. .env is gitignored.

# Postgres (the compose db service reads these)
POSTGRES_DB=bidbuilder
POSTGRES_USER=bidbuilder
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key for the API — must be >= 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-signing-key-at-least-32-bytes

# ── Production only (docker-compose.prod.yml) ───────────────────────────────────
# Public hostname + URL the site is served from (single origin behind Caddy/TLS).
PUBLIC_DOMAIN=bid.example.com
PUBLIC_URL=https://bid.example.com
# Contact email for Let's Encrypt certificate notices.
ACME_EMAIL=ops@example.com
# First-run admin seed. In Production no admin is created unless this is set.
# Leave blank to create the initial admin out-of-band instead.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com

# ── Email / SMTP (21.1) ─────────────────────────────────────────────────────────
# Outbound transactional email (notification copies + subcontractor RFQ invites).
# Disabled by default — the app never sends mail unless Email__Enabled=true AND a
# host + From address are set. The password is a SECRET: set it here / in your secret
# store, never in appsettings. AppBaseUrl makes links in emails absolute (defaults to
# the first AllowedOrigins / PUBLIC_URL when blank).
Email__Enabled=false
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__UseSsl=true
Email__FromAddress=noreply@example.com
Email__FromName=BidBuilder
Email__AppBaseUrl=

# ── Notification email digests (22.1) ───────────────────────────────────────────
# A background scheduler batches each opted-in user's in-app notifications into a
# periodic email (Off/Daily/Weekly, chosen per user in Settings). No-ops unless the
# Email transport above is configured. Set Enabled=false to switch the scheduler off;
# IntervalSeconds tunes how often it wakes to check for due digests (min 60).
Digests__Enabled=true
Digests__IntervalSeconds=900

# ── Backup / PITR cadence (19.4) ────────────────────────────────────────────────
# Logical pg_dump cadence + retention (the daily nightly).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Physical base-backup cadence (anchors PITR replay). Weekly by default.
BASEBACKUP_INTERVAL_SECONDS=604800
# WAL retention. Must be ≥ BASEBACKUP_INTERVAL_SECONDS / 86400, ideally double,
# so we never prune WAL that would orphan a base backup we still want to use.
WAL_RETENTION_DAYS=21
